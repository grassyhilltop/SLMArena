{
  "site_name": "SLMArena",
  "repo": "grassyhilltop/SLMArena",
  "site_url": "https://grassyhilltop.github.io/SLMArena/",
  "author": "Joel Sadler",
  "affiliation": "University of Virginia, School of Data Science",
  "slm_rule": {
    "vram_gb": 32,
    "bytes_per_param_4bit": 0.5,
    "weights_share_of_vram": 0.75,
    "note": "An SLM is an open-weight model whose 4-bit weights fill at most 75% of a 32 GB GPU: 0.5 GB per billion parameters, so at most 48B total parameters."
  },
  "anthropic_class_max_b": 31,
  "fit": {
    "interval": 0.9,
    "windows": {
      "since2023": "2023-07-01",
      "last24": "-730"
    }
  },
  "thresholds": [
    {
      "key": "selfrep",
      "kind": "model",
      "model": "GLM-5.2",
      "label": "Self-replication floor",
      "short": "self-replication floor",
      "anthropic_value": 151.8,
      "source": "https://www.anthropic.com/research/self-replicating-ai"
    },
    {
      "key": "frontier",
      "kind": "frontier_now",
      "label": "Today's SOTA",
      "short": "today's SOTA"
    },
    {
      "key": "frontier1y",
      "kind": "frontier_ago",
      "days": 365,
      "label": "SOTA one year ago",
      "short": "SOTA of a year ago"
    }
  ],
  "newsletter": {
    "provider": "buttondown",
    "username": "tinylm",
    "send_alerts": true
  },
  "anthropic_post": {
    "date": "2026-10-12",
    "url": "https://www.anthropic.com/research/self-replicating-ai",
    "floor_model": "GLM-5.2",
    "floor_eci": 151.8,
    "best_model": "Qwen3.8-27B",
    "best_eci": 149.4,
    "gap": 2.4,
    "slope": 13.7,
    "r2": 0.95,
    "class": "open-weight models of 30B total parameters or fewer",
    "projection": "by the end of 2026"
  }
}
